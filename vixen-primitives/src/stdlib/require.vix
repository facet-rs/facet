// `require(condition) where { message }` — the explicit requirement fallback
// the machine-manifest design names (`vixen.machine.requirements-from-use`):
// when a requirement cannot be extracted from use — a fact the capability
// package's command grammar cannot see — the program states it itself, over
// the ordinary `fail` mechanism (issue 2600). The failure is typed, a
// `RequirementFailure` carrying the author's message; a satisfied
// requirement is an ordinary `true`.
//
// Demand semantics apply as everywhere: an undemanded `require` never runs
// (undemanded-is-free), so a program yields it through `expect`. The message
// is a where-argument and therefore a wire — it is demanded only on the
// failing branch.

pub struct RequirementFailure { message: String }

pub fn require(condition: Bool) where { message: String } -> Bool {
    if condition {
        true
    } else {
        fail RequirementFailure { message: message }
    }
}
