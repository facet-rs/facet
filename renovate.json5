{
  // Repo-level Renovate config — overrides org/app defaults.
  //
  // Goal: hear about every update immediately, without 60 rate-limited
  // ghost PRs on the dependency dashboard. Steady state is ~3 live PRs:
  //   1. one rolling "all non-major dependencies" PR (ranges + pins),
  //   2. one Monday lockfile-maintenance PR (in-range lockfile drift),
  //   3. individual PRs for each major, visible the moment they exist.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Group every non-major update into a single rolling PR. Majors stay
    // ungrouped on purpose: they deserve individual eyes (syn 3, ts 7, …).
    "group:allNonMajor",
  ],
  // The drip-feed limits are what made updates invisible for weeks.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  // Weekly wholesale lockfile regeneration (the automated version of the
  // 2026-07-24 in-range mega-update, #2535).
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },
  packageRules: [
    {
      // Cargo semver: for 0.x crates the MINOR field is the breaking one
      // (0.21 -> 0.23 is an API break). Renovate labels those "minor", so
      // group:allNonMajor happily swept ~15 breaking Rust upgrades into one
      // PR — rusqlite 0.32->0.40, tower 0.4->0.5, rand 0.9->0.10, … — which
      // renovate itself then failed to lock (#2546). Ungroup them so each
      // arrives as its own reviewable PR, like the major it actually is.
      description: "Cargo 0.x minor bumps are breaking — never group them",
      matchDatasources: ["crate"],
      matchCurrentVersion: "/^[\\^~]?0\\./",
      matchUpdateTypes: ["minor"],
      groupName: null,
    },
    {
      // A toolchain bump can break every crate at once; it should never ride
      // along with dependency updates.
      description: "Rust toolchain gets its own PR",
      matchPackageNames: ["rust"],
      groupName: null,
    },
  ],
}
