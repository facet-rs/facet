// package.vix — the vix half of the package-manifest seam: the reader and
// handler for `package.styx`. The document types here MIRROR the Rust crate
// `vix-package-schema`, which is the single source of truth whose facet
// Shape crosses to every consumer; this module is the language-side spelling
// of the same shapes. Two rules keep the mirror honest with no rename
// surface in vix:
//
//   - enum tags: the decoder matches a document tag against the kebab
//     spelling of the variant identifier (`ExitOnly` ⇔ `@exit-only`), the
//     same rule `rename_all = "kebab-case"` applies on the Rust side;
//   - field names: single words only (`os`, not `os-role`), so every field
//     is spellable identically in styx, Rust, and vix.
//
// The parse itself is one `styx_decode` binding — the manifest is dead data,
// and everything below `manifest()` is interrogation of the decoded value,
// not parsing.

pub struct PackageMeta {
    name: String,
    version: String,
}

pub enum Unpack {
    TarGz,
    TarXz,
}

// One arm per way a value enters a package from outside. No Path arm on
// purpose: a local directory is an unpinned word, and overrides are policy
// (`vx r --override-input`), never manifest content.
pub enum Input {
    Package { version: String, hash: String },
    Fetch { origin: String, hash: String, unpack: Unpack },
}

// A command and an artifact are both bare fn refs; the map key is the public
// name, the fn path is package-private. They stay two types because the two
// sections carry different claims (a command presents; an artifact must
// return Tree or Blob).
pub struct Command {
    fn: String,
}

pub struct Artifact {
    fn: String,
}

// Where an exposed program's tree comes from — invisible to consumers, which
// is the composability seam: fetched toolchain and built artifact provide
// capabilities identically.
pub enum ProgramSource {
    Input { name: String, path: String },
    Artifact { name: String, path: String },
}

pub enum Protocol {
    ExitOnly,
    ProgressiveLinesV1,
}

pub enum Target {
    Neutral,
    ArgvFlag { flag: String },
    EnvRoles { os: String, arch: String },
    FixedTarget { target: String },
}

pub struct Program {
    source: ProgramSource,
    protocol: Protocol,
    target: Target,
}

// Sections are Option<Map<…>> because a manifest may omit a section, and vix
// spells "absent decodes to empty" as absence. The accessors below hand out
// the empty map so no caller reasons about presence.
pub struct PackageManifest {
    package: PackageMeta,
    input: Option<Map<String, Input>>,
    command: Option<Map<String, Command>>,
    artifact: Option<Map<String, Artifact>>,
    program: Option<Map<String, Program>>,
}

pub fn manifest(text: String) -> PackageManifest {
    styx_decode(text)
}

pub fn inputs(m: PackageManifest) -> Map<String, Input> {
    let empty: Map<String, Input> = %{};
    m.input.unwrap_or(empty)
}

pub fn commands(m: PackageManifest) -> Map<String, Command> {
    let empty: Map<String, Command> = %{};
    m.command.unwrap_or(empty)
}

pub fn artifacts(m: PackageManifest) -> Map<String, Artifact> {
    let empty: Map<String, Artifact> = %{};
    m.artifact.unwrap_or(empty)
}

pub fn programs(m: PackageManifest) -> Map<String, Program> {
    let empty: Map<String, Program> = %{};
    m.program.unwrap_or(empty)
}

// The fn a runner resolves for `vx r <pkg> <name>`. Addressed on purpose: an
// absent command is the map's own loud failure, never a silent None.
pub fn command_fn(m: PackageManifest) where { name: String } -> String {
    commands(m).get(name).fn
}

// ---------------------------------------------------------- union accessors
//
// The unions are interrogated HERE, where they are local: a variant path
// does not cross a module boundary in today's vix (`package::Input::Fetch`
// resolves nowhere outside this file), so the handler owns the matches and
// exposes answers. The `*_label` fns answer with the manifest's own tag
// vocabulary — the label IS the `@tag` the document spells, not a second
// enumeration to keep in sync.

pub fn input_label(input: Input) -> String {
    match input {
        Input::Package { version, hash } => "package",
        Input::Fetch { origin, hash, unpack } => "fetch",
    }
}

// Every input arm carries a pin — the manifest's whole job in one accessor.
pub fn input_pin(input: Input) -> String {
    match input {
        Input::Package { version, hash } => hash,
        Input::Fetch { origin, hash, unpack } => hash,
    }
}

pub fn input_version(input: Input) -> Option<String> {
    match input {
        Input::Package { version, hash } => Some(version),
        Input::Fetch { origin, hash, unpack } => None,
    }
}

pub fn fetch_origin(input: Input) -> Option<String> {
    match input {
        Input::Package { version, hash } => None,
        Input::Fetch { origin, hash, unpack } => Some(origin),
    }
}

pub fn fetch_unpack(input: Input) -> Option<String> {
    match input {
        Input::Package { version, hash } => None,
        Input::Fetch { origin, hash, unpack } => Some(unpack_label(unpack)),
    }
}

pub fn unpack_label(unpack: Unpack) -> String {
    match unpack {
        Unpack::TarGz => "tar-gz",
        Unpack::TarXz => "tar-xz",
    }
}

// Both source arms carry a name and a path — asking either never depends on
// which arm answered, which is the composability seam restated as an API.
pub fn source_label(source: ProgramSource) -> String {
    match source {
        ProgramSource::Input { name, path } => "input",
        ProgramSource::Artifact { name, path } => "artifact",
    }
}

pub fn source_name(source: ProgramSource) -> String {
    match source {
        ProgramSource::Input { name, path } => name,
        ProgramSource::Artifact { name, path } => name,
    }
}

pub fn source_path(source: ProgramSource) -> String {
    match source {
        ProgramSource::Input { name, path } => path,
        ProgramSource::Artifact { name, path } => path,
    }
}

pub fn protocol_label(protocol: Protocol) -> String {
    match protocol {
        Protocol::ExitOnly => "exit-only",
        Protocol::ProgressiveLinesV1 => "progressive-lines-v1",
    }
}

pub fn target_label(discipline: Target) -> String {
    match discipline {
        Target::Neutral => "neutral",
        Target::ArgvFlag { flag } => "argv-flag",
        Target::EnvRoles { os, arch } => "env-roles",
        Target::FixedTarget { target } => "fixed-target",
    }
}

pub fn target_flag(discipline: Target) -> Option<String> {
    match discipline {
        Target::Neutral => None,
        Target::ArgvFlag { flag } => Some(flag),
        Target::EnvRoles { os, arch } => None,
        Target::FixedTarget { target } => None,
    }
}

// Does one program source name a thing the manifest actually declares?
fn source_resolves(source: ProgramSource)
    where { declared_artifacts: Map<String, Artifact>, declared_inputs: Map<String, Input> }
    -> Bool
{
    match source {
        ProgramSource::Artifact { name, path } => declared_artifacts.has(name),
        ProgramSource::Input { name, path } => declared_inputs.has(name),
    }
}

// The manifest-local half of binding-fails-before-effects: every program
// must source from a declared artifact or input. Returns the program names
// that do NOT resolve — an empty answer is the manifest's coherence proof,
// a non-empty one is the loud list a binder fails with.
pub fn dangling_program_sources(m: PackageManifest) -> [String] {
    let declared_artifacts = artifacts(m);
    let declared_inputs = inputs(m);
    let progs = programs(m);
    let none: [String] = [];
    progs.keys().fold(none, |bad, key| {
        let resolves = source_resolves(progs.get(key).source)
            where { declared_artifacts: declared_artifacts, declared_inputs: declared_inputs };
        if resolves { bad } else { bad + key }
    })
}
