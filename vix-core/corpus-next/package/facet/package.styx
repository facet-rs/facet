// package.styx — the data half of the facet package; facet.vix is the code
// half. Everything in this file is a LITERAL: names, versions, pins, fn refs,
// paths into trees. If it needs computing, it lives across the seam in a .vix
// fn this file merely names. flake.nix polices the same split with a
// restricted evaluator mode bolted onto a full language; here the split is a
// file boundary and the parser is the police.
//
// Spelling notes, learned from the real parser: a styx entry is at most two
// atoms (key + value), so every section is a MAP whose keys are the public
// names — there is no `command build { … }` three-atom form, and repeated
// keys are duplicate-key errors, not accumulation. A tag's payload must be
// adjacent (`@package{…}`, no space). Sequences use parentheses. One-field
// entries use attribute sugar (`build fn>facet::build` is parser[attr.atom]
// shorthand for `build { fn facet::build }` — same document, same decode).

package {
  name facet
  version "0.1.0"
}

// A provider pin, NOT a requirement list. Requirements stay where they always
// are — the capability parameters of the fns named below
// (vixen.machine.requirements-from-use). This section answers the other
// question: when those fns demand `Rustc`, WHICH package satisfies it, at
// which identity. The key is the provider package's name; the hash is its
// source-tree identity, and because cargo's own package.styx lives inside
// that tree, its rust-dist pin is covered transitively — one hash pins the
// closure, with no lockfile.
//
// @package is one arm of the input union; @fetch (see ../cargo/package.styx)
// is the other. There is deliberately no @path arm: a local directory is an
// unpinned word, and overrides belong to policy (`vx r --override-input
// cargo=../cargo`), which may change WHERE work happens but never what a
// demand means.
input {
  cargo @package{
    version "0.1.0"
    hash "blake3:deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdead"
  }
}

// `vx r facet build` — or `vx r build` from inside this package. A command is
// a bare fn ref: the fn is the whole recipe, the key is its public name. The
// fn's return type decides what `vx r` presents; its parameters declare its
// requirements; the manifest repeats neither.
command {
  build fn>facet::build
  test fn>facet::test
}

// `vx build facet#bins` — demand facet::build, materialize the resulting Tree
// at ./result (vixen.delivery.result). Purity makes the second build a store
// hit; an artifact has no existence apart from its fn's value. Naming a fn
// here claims it returns Tree or Blob, and binding checks the claim before
// any effect runs — a record-returning fn fails at binding, not at delivery.
// The artifact key is committed API; the fn path is private and renameable.
artifact {
  bins fn>facet::build
}

// The executable this package exposes: a path into an artifact's value, plus
// the capability-package contracts. A consumer demanding the `Fx` capability
// cannot tell built-here from fetched — @artifact here and @input in cargo's
// manifest are the two arms of one source union, invisible downstream.
// Every enum value wears its @tag: a choice from a closed set is visibly a
// choice.
program {
  fx {
    source @artifact{
      name bins
      path "bin/fx"
    }
    protocol @exit-only
    target @neutral
  }
}
