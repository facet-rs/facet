@schema {id crate:dodeca-config@1, cli ddc}

source {
    content docs/content
    repo "https://github.com/facet-rs/facet/tree/main/vix"

    impls (
        {
            name rust
            include ("src/**/*.rs")
            test_include ("tests/**/*.rs")
        }
        {
            // `corpus-next/**` is deliberately absent. It is design fiction —
            // libpng/main.vix opens with "DESIGN FICTION. Nothing here runs." —
            // and a bare `r[rule]` in one of its comments was counting as an
            // implementation. That inflated the implemented figure by 15 rules
            // and supplied 6 of the 7 invalid references. A sketch pressures a
            // rule; it does not implement one, and the coverage number is only
            // worth having if it cannot be raised by writing a comment.
            name vix
            include ("std/**/*.vix" "tests/ratchet/**/*.vix")
        }
        {
            name weavy
            root ../weavy
            include (
                "build/**/*.rs"
                "src/exec.rs"
                "src/jit/**/*.rs"
                "src/task.rs"
                "src/verified.rs"
                "stencils/task_ops.rs"
            )
            test_include ("tests/**/*.rs")
        }
    )
}

site {
    output docs/public
}
