
// Rung 128 — progressive exec trees, the primary exec shape: stage one
// writes early.txt immediately and announces it through the capability's
// output protocol, then sleeps before finishing its tree. Stage two
// consumes ONLY early.txt — and must complete, by Completed-event order,
// before stage one's process exits. Subfile demand, not whole-output
// demand. Product readiness is the declared protocol's authority
// (machine.primitive.command-package), so the capability is the
// announcing ProgressiveSh, never a filesystem poll.
#[test { budget_wall: 2s, budget_rss: 256MB }]
fn progressive_tree(sh: ProgressiveSh) -> Stream<Check> {
    let producer = exec sh`-c "mkdir -p out; echo ready > out/early.txt; printf 'vix-ready\tout/early.txt\n'; sleep 1.5; echo done > out/late.txt"`;
    let consumer = (producer.tree / "out" / "early.txt").text();
    yield expect_eq(consumer.trim(), "ready");
    yield finished_before(consumer, producer);
}
